VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (scripts/setup.mjs, scripts/seed.mjs). Never commit. Never bundle to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# Premier compte admin, créé par `npm run setup`. Doit être l'email réel du
# client (pas un compte de test) : c'est ce compte qui devient propriétaire
# (is_owner = true) sur une base fraîche.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NOM=Doe
ADMIN_PRENOM=John

# Identité de marque (voir src/config/brand.js) — pilote le nom/logo/couleur
# affichés dans l'app, les PDF générés et les emails. Toutes optionnelles :
# sans elles, l'app retombe sur les valeurs par défaut définies dans brand.js.
VITE_BRAND_NAME=PNM Sports
VITE_BRAND_LEGAL_NAME=PNM Sports
VITE_BRAND_DOMAIN=pnm-sports.com
VITE_BRAND_CONTACT_EMAIL=contact@pnm-sports.com
VITE_BRAND_THEME_COLOR=#04101f

# Secrets des Edge Functions Supabase (à définir dans Supabase → Project
# Settings → Edge Functions → Secrets, PAS dans ce fichier .env.local qui ne
# concerne que le build client/les scripts locaux).
#
# RESEND_API_KEY   — obligatoire pour les briques d'envoi d'email
#                     (send-notification-email, send-player-pdf).
# CONTACT_FROM     — obligatoire dès que RESEND_API_KEY est défini, ex.
#                     "Mon Agence <contact@mon-domaine.com>" ; doit
#                     correspondre à un domaine vérifié sur Resend.
# ANTHROPIC_API_KEY — pour les briques IA (générateur de documents, assistant
#                     juridique) : extract-document-clauses,
#                     extract-legal-chunks, legal-assistant-query.
# GEMINI_API_KEY    — repli automatique si ANTHROPIC_API_KEY échoue (mêmes
#                     fonctions), optionnel.
