{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd pnm-app && npm install",
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": "site",
  "rewrites": [
    { "source": "/login", "destination": "/agent/index.html" },
    { "source": "/reset-password", "destination": "/agent/index.html" },
    { "source": "/dashboard", "destination": "/agent/index.html" },
    { "source": "/profile", "destination": "/agent/index.html" },
    { "source": "/players", "destination": "/agent/index.html" },
    { "source": "/players/:path*", "destination": "/agent/index.html" },
    { "source": "/recrutement", "destination": "/agent/index.html" },
    { "source": "/agents", "destination": "/agent/index.html" },
    { "source": "/features", "destination": "/agent/index.html" },
    { "source": "/clubs", "destination": "/agent/index.html" },
    { "source": "/clubs/:path*", "destination": "/agent/index.html" },
    { "source": "/besoins-clubs", "destination": "/agent/index.html" },
    { "source": "/agenda", "destination": "/agent/index.html" },
    { "source": "/pipeline", "destination": "/agent/index.html" },
    { "source": "/commissions", "destination": "/agent/index.html" },
    { "source": "/audit", "destination": "/agent/index.html" },
    { "source": "/rgpd", "destination": "/agent/index.html" },
    { "source": "/portefeuille", "destination": "/agent/index.html" },
    { "source": "/rapports", "destination": "/agent/index.html" },
    { "source": "/blog", "destination": "/agent/index.html" },
    { "source": "/vitrine", "destination": "/agent/index.html" },
    { "source": "/actualites", "destination": "/agent/index.html" },
    { "source": "/actualites/:path*", "destination": "/agent/index.html" },
    { "source": "/documents", "destination": "/agent/index.html" },
    { "source": "/documents/:path*", "destination": "/agent/index.html" },
    { "source": "/assistant-juridique", "destination": "/agent/index.html" },
    { "source": "/assistant-juridique/:path*", "destination": "/agent/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
